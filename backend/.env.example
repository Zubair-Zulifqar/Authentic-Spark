APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./authentic_spark.db
# dev: accepts "dev:<email>" bearer tokens (never in production). firebase: verifies Firebase ID tokens.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
CORS_ORIGINS=http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:8080
WEBHOOK_SIGNING_SECRET=change-me-locally
SCHEDULER_TOKEN=change-me-locally
# Optional provider credentials. When empty, explicitly-labelled mock adapters are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ZEROBOUNCE_API_KEY=
NGPVAN_APP_NAME=
NGPVAN_API_KEY=
SCALETOWIN_API_KEY=
ASANA_ACCESS_TOKEN=
ASANA_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_WEBHOOK_VERIFIER_TOKEN=
QBO_ENVIRONMENT=sandbox
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v21
MIXPANEL_TOKEN=
